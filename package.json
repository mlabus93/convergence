{
  "name": "convergence",
  "description": "group travel planning app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "pretest": "node packages/vitest-config/scripts/clean-blob-reports.mjs",
    "test": "turbo run test",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "report": "pnpm test && pnpm --filter @repo/vitest-config report",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@repo/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.1.0"
}
